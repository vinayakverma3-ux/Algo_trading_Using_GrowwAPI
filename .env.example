# TOTP flow (recommended — auto-renews, no daily manual step)
GROWW_API_KEY=your_api_key_here
GROWW_API_SECRET=your_totp_secret_here

# OR: static access token flow (expires daily ~6:00 AM IST)
# GROWW_ACCESS_TOKEN=paste_token_here

# Set to "true" to expose place_order / cancel_order as MCP tools.
# Leave unset for read-only access.
GROWW_ENABLE_TRADING=false

# Telegram alerts (from @BotFather; run setup_telegram.py to find chat id)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
